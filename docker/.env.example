# ============================================================
# SmartTravel Docker 部署环境变量模板
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
# ============================================================

# ---- JWT ----
JWT_SECRET_KEY=smarttravel-prod-secret-key

# ---- 阿里云短信（号码认证服务）----
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
SMS_SIGN_NAME=云涟科技验证平台
SMS_TEMPLATE_CODE=100001

# ---- Dify AI 工作流（自托管 Dify 实例）----
DIFY_BASE_URL=http://host.docker.internal
DIFY_INTENT_PARSER_KEY=app-xxxxxxxxxxxxx
DIFY_ITINERARY_GENERATOR_KEY=app-xxxxxxxxxxxxx
DIFY_REPLAN_AGENT_KEY=app-xxxxxxxxxxxxx

# ---- 支付宝沙箱支付 ----
ALIPAY_APP_ID=9021000165607124
ALIPAY_NOTIFY_URL=http://your-natapp-url.natappfree.cc/api/v1/payment/alipay/notify
ALIPAY_RETURN_URL=http://localhost/user/member?paid=1

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=smarttravel
MYSQL_USER=smarttravel
MYSQL_PASSWORD=smarttravel123

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=smarttravel
RABBITMQ_DEFAULT_PASS=smarttravel123

# ---- Elasticsearch ----
ES_JAVA_OPTS=-Xms256m -Xmx512m
